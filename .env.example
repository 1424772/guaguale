APP_ENV=development
API_PORT=8080
COOKIE_SECURE=false
GOPROXY=https://goproxy.cn,direct

MYSQL_DATABASE=guaguale
MYSQL_USER=guaguale
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password
MYSQL_MAX_OPEN_CONNS=40
MYSQL_MAX_IDLE_CONNS=10
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH_B64=base64-encoded-bcrypt-hash
ADMIN_SESSION_SECRET_B64=base64-encoded-random-32-byte-secret

REDIS_PASSWORD=replace-with-a-strong-password
